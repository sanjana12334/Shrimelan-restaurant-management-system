# ---------- Server ----------
NODE_ENV=development
PORT=4000
APP_BASE_URL=http://localhost:5173
STAFF_BASE_URL=http://localhost:5174

# ---------- Database (Railway PostgreSQL) ----------
DATABASE_URL=postgresql://<username>:<password>@<host>:5432/<database>?schema=public

# ---------- Redis (Railway Redis / BullMQ) ----------
REDIS_URL=redis://<user>:<password>@<host>:6379

# ---------- Auth ----------
JWT_SECRET=<generate-a-long-random-secret>
JWT_EXPIRES_IN=8h
COOKIE_NAME=shrimelan_staff_session
COOKIE_DOMAIN=
SESSION_SECRET=<generate-a-long-random-secret>
TABLE_SESSION_COOKIE_NAME=shrimelan_table_session
TABLE_SESSION_TTL_MS=7200000

# ---------- CORS ----------
CORS_ORIGIN=http://localhost:5173,http://localhost:5174g

# ---------- Cloudflare R2 (menu & restaurant images) ----------
R2_ACCOUNT_ID=xxxxxxxxxxxxxxxxxxxx
R2_ACCESS_KEY_ID=xxxxxxxxxxxxxxxxxxxx
R2_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxx
R2_BUCKET_NAME=<your-r2-bucket-name>
R2_PUBLIC_URL=<your-r2-public-url>

# ---------- Rate limiting ----------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_PUBLIC=120
RATE_LIMIT_MAX_ORDER_CREATE=10
RATE_LIMIT_MAX_TABLE_SESSION=20
RATE_LIMIT_MAX_ORDER_TRACKING=30
RATE_LIMIT_MAX_ADMIN=120

# ---------- Notifications (optional SMS provider) ----------
SMS_PROVIDER_API_KEY=
SMS_SENDER_ID=SHRMLN

# ---------- Error monitoring ----------
SENTRY_DSN=

# ---------- Seed / bootstrap admin (first run only) ----------
SEED_ADMIN_EMAIL=owner@shrimelan.com
SEED_ADMIN_PASSWORD=<provide-a-unique-12-plus-character-password>
